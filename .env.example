# Production Environment Variables Template
# Copy this file to .env before running docker-compose up -d

# Application Spring Profile (default: prod)
SPRING_PROFILES_ACTIVE=prod

# PostgreSQL Database Credentials
DB_NAME=haribhakthi_sara
DB_USER=postgres
DB_PASSWORD=SetSecurePostgresPasswordHere

# JWT Authentication Secret Key (Generate a random 64+ char secret)
JWT_SECRET=SetSecureProductionJwtSecretKeyHere320498230948029384

# Initial Admin Account Credentials (Used during first database setup)
ADMIN_EMAIL=admin@haribhakthi.com
ADMIN_INITIAL_PASSWORD=SetYourInitialAdminPasswordHere123!

# Storage Type (local or s3)
APP_STORAGE_TYPE=local
MEDIA_STORAGE_PATH=/var/haribhakthi_media_storage

# Allowed CORS Origins (Comma separated)
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:3000,http://yourdomain.com
